for_0_end:

if9_end:

if7_end:
	// src/OrangeMiner.algo.ts:318
	// this.lastPriceRound.value = globals.round
	byte 0x6c6173745072696365526f756e64 // "lastPriceRound"
	global Round
	app_global_put

	// src/OrangeMiner.algo.ts:319
