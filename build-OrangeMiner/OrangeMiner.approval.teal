	byte 0x706f6f6c546f6b656e // "poolToken"
	app_global_get
	itxn_field XferAsset

	// src/OrangeMiner.algo.ts:207
	// assetReceiver: to
	frame_dig -2 // to: Address
	itxn_field AssetReceiver

	// src/OrangeMiner.algo.ts:208
	// assetAmount: toSend
	frame_dig 1 // toSend: uint64
	itxn_field AssetAmount

	// src/OrangeMiner.algo.ts:209
	// fee: 0
	int 0
	itxn_field Fee

	// Submit inner transaction
	itxn_submit

	// src/OrangeMiner.algo.ts:212
	// this.totalWithdrawn.value = this.totalWithdrawn.value + toSend
	byte 0x746f74616c57697468647261776e // "totalWithdrawn"
	dup
	app_global_get
	frame_dig 1 // toSend: uint64
	+
	app_global_put

	// src/OrangeMiner.algo.ts:213
	// balance.totalWithdrawn = balance.totalWithdrawn + toSend
	int 56 // headOffset
	frame_dig -1 // from: Address
	int 56 // headOffset
	int 8
	box_extract
	btoi
	frame_dig 1 // toSend: uint64
	+
	itob
	frame_dig 0 // storage key//balance
	cover 2
	box_replace

	// src/OrangeMiner.algo.ts:214
	// balance.claimable = balance.claimable - toSend
	int 64 // headOffset
	frame_dig -1 // from: Address
	int 64 // headOffset
	int 8
	box_extract
	btoi
	frame_dig 1 // toSend: uint64
	-
	itob
	frame_dig 0 // storage key//balance
	cover 2
	box_replace

if4_end:
	retsub

// returnDeposit(from: Address, to: Address, bps: number): void
returnDeposit:
	proto 3 0

	// Push empty bytes after the frame pointer to reserve space for local variables
	byte 0x
	dup

	// src/OrangeMiner.algo.ts:219
	// balance = this.balances(from).value
	frame_dig -1 // from: Address
	frame_bury 0 // storage key//balance

	// src/OrangeMiner.algo.ts:220
	// toSend = (balance.deposited * bps) / 10000
	frame_dig -1 // from: Address
	int 0
	int 8
	box_extract
	btoi
	frame_dig -3 // bps: number
	*
	int 10000
	/
	frame_bury 1 // toSend: uint64

	// if5_condition
	// src/OrangeMiner.algo.ts:222
	// toSend > 1
	frame_dig 1 // toSend: uint64
	int 1
	>
	bz if5_end

