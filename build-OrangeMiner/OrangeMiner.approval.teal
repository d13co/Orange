	int 16
	-
	swap
	substring3
	concat
	byte 0x70 // "p"
	box_get
	assert
	frame_dig 6 // index: uint64
	int 160
	frame_dig 6 // index: uint64
	-
	extract3
	concat
	box_put
	b for_0_end

if10_end:
	// src/OrangeMiner.algo.ts:305
	// i = i + 1
	frame_dig 5 // i: uint64
	int 1
	+
	frame_bury 5 // i: uint64
