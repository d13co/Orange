	// src/OrangeMiner.algo.ts:241
	// this.returnDeposit(this.txn.sender, this.txn.sender, depositBps)
	frame_dig -2 // depositBps: number
	txn Sender
	txn Sender
	callsub returnDeposit

	// src/OrangeMiner.algo.ts:243
	// log(rawBytes(this.balances(this.txn.sender).value))
	txn Sender
	box_get
	assert
	log
	retsub

// repay(address)void
abi_route_repay:
	// address: address
	txna ApplicationArgs 1
	dup
	len
	int 32
	==
	assert

	// execute repay(address)void
	callsub repay
	int 1
