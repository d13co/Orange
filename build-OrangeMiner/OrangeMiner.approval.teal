// repay(address: Address): void
repay:
	proto 1 0

	// Push empty bytes after the frame pointer to reserve space for local variables
	byte 0x
	dupn 4

	// src/OrangeMiner.algo.ts:247
	// assert(this.txn.groupIndex > 0)
	txn GroupIndex
	int 0
	>
	assert

	// src/OrangeMiner.algo.ts:248
	// payment = this.txnGroup[this.txn.groupIndex - 1]
	txn GroupIndex
	int 1
	-
	frame_bury 0 // payment: txn

	// src/OrangeMiner.algo.ts:249
	// assert(payment.typeEnum === TransactionType.Payment)
	frame_dig 0 // payment: txn
	gtxns TypeEnum
	int pay
	==
	assert

	// src/OrangeMiner.algo.ts:250
	// assert(payment.receiver === this.app.address)
	frame_dig 0 // payment: txn
	gtxns Receiver
	global CurrentApplicationAddress
	==
	assert

	// src/OrangeMiner.algo.ts:252
	// this.updatePerToken()
	callsub updatePerToken

	// src/OrangeMiner.algo.ts:253
	// balance = this.balances(address).value
	frame_dig -1 // address: Address
	frame_bury 1 // storage key//balance

	// src/OrangeMiner.algo.ts:254
	// deposited = balance.deposited
	frame_dig -1 // address: Address
	int 0
	int 8
	box_extract
	btoi
	frame_bury 2 // deposited: uint64

	// src/OrangeMiner.algo.ts:255
	// spent = this.updateBalance(address, payment.amount)
	frame_dig 0 // payment: txn
	gtxns Amount
	frame_dig -1 // address: Address
	callsub updateBalance
	frame_bury 3 // spent: uint64

	// src/OrangeMiner.algo.ts:257
	// assert(spent + this.minDeposit.value > deposited)
	frame_dig 3 // spent: uint64
	byte 0x6d696e4465706f736974 // "minDeposit"
	app_global_get
	+
	frame_dig 2 // deposited: uint64
	>
	assert

	// if6_condition
	// src/OrangeMiner.algo.ts:259
	// spent > deposited
	frame_dig 3 // spent: uint64
	frame_dig 2 // deposited: uint64
	>
	bz if6_end

	// if6_consequent
	// src/OrangeMiner.algo.ts:260
	// rewardsKeptBps = (deposited * 10000) / spent
	frame_dig 2 // deposited: uint64
	int 10000
	*
	frame_dig 3 // spent: uint64
	/
	frame_bury 4 // rewardsKeptBps: uint64

	// src/OrangeMiner.algo.ts:261
	// this.sendRewards(address, this.txn.sender, 10000 - rewardsKeptBps)
	int 10000
	frame_dig 4 // rewardsKeptBps: uint64
	-
	txn Sender
	frame_dig -1 // address: Address
	callsub sendRewards

if6_end:
	// src/OrangeMiner.algo.ts:264
	// this.returnDeposit(address, this.txn.sender, 10000)
