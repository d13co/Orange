	box_get
	assert
	log
	retsub

// updatePrice(): uint128
updatePrice:
	proto 0 1

	// Push empty bytes after the frame pointer to reserve space for local variables
	byte 0x
	dupn 6

	// src/OrangeMiner.algo.ts:270
	// roundDifference = globals.round - this.lastPriceRound.value
	global Round
	byte 0x6c6173745072696365526f756e64 // "lastPriceRound"
	app_global_get
	-
	frame_bury 0 // roundDifference: uint64

	// src/OrangeMiner.algo.ts:271
	// scale = SCALE as uint128
	byte 0x00000000000000010000000000000000
	frame_bury 1 // scale: uint128

	// src/OrangeMiner.algo.ts:273
	// reservesA = this.poolApplication.value.localState(
	//       this.poolAddress.value,
	//       'asset_1_reserves',
	//     ) as uint64
	byte 0x706f6f6c4170706c69636174696f6e // "poolApplication"
	app_global_get
	byte 0x706f6f6c41646472657373 // "poolAddress"
	app_global_get
	byte 0x61737365745f315f7265736572766573 // "asset_1_reserves"
	swap
	cover 2
	app_local_get_ex
	assert
	frame_bury 2 // reservesA: uint64

	// src/OrangeMiner.algo.ts:278
	// reservesB = this.poolApplication.value.localState(
	//       this.poolAddress.value,
	//       'asset_2_reserves',
	//     ) as uint64
	byte 0x706f6f6c4170706c69636174696f6e // "poolApplication"
	app_global_get
	byte 0x706f6f6c41646472657373 // "poolAddress"
	app_global_get
	byte 0x61737365745f325f7265736572766573 // "asset_2_reserves"
	swap
	cover 2
	app_local_get_ex
	assert
	frame_bury 3 // reservesB: uint64

	// src/OrangeMiner.algo.ts:282
	// price = ((reservesB as uint128) * scale) / (reservesA as uint128)
	frame_dig 3 // reservesB: uint64
	itob
	byte 0x00000000000000010000000000000000 // scale: uint128
	b*
	frame_dig 2 // reservesA: uint64
	itob
	b/
	frame_bury 4 // price: unsafe uint128

	// if7_condition
	// src/OrangeMiner.algo.ts:284
	// roundDifference > 0
	frame_dig 0 // roundDifference: uint64
	int 0
	>
	bz if7_end

	// if7_consequent
	// if8_condition
	// src/OrangeMiner.algo.ts:286
	// roundDifference > 10
	frame_dig 0 // roundDifference: uint64
	int 10
	>
	bz if8_end

	// if8_consequent
	// src/OrangeMiner.algo.ts:287
	// this.prices.value = castBytes<StaticArray<uint128, 10>>(bzero(160))
	byte 0x70 // "p"
	byte 
	box_put

if8_end:
	// if9_condition
	// src/OrangeMiner.algo.ts:289
	// price < this.prices.value[0]
	frame_dig 4 // price: unsafe uint128
	byte 0x70 // "p"
	int 0
	int 16
	box_extract
	b<
	bz if9_elseif1_condition

	// if9_consequent
	// src/OrangeMiner.algo.ts:293
	// this.prices.value = castBytes<StaticArray<uint128, 10>>(
	//           rawBytes(price) + extract3(rawBytes(this.prices.value), 0, 144),
	//         )
	byte 0x70 // "p"
	frame_dig 4 // price: unsafe uint128
	dup
	bitlen
	int 128
	<=
	assert
	byte 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
	b&
	dup
	len
	dup
	int 16
	-
	swap
	substring3
	byte 0x70 // "p"
	int 0
	int 144
	box_extract
	concat
	box_put
	b if9_end

if9_elseif1_condition:
	// src/OrangeMiner.algo.ts:296
	// price >= this.prices.value[9]
	frame_dig 4 // price: unsafe uint128
	byte 0x70 // "p"
	int 144
	int 16
	box_extract
	b>=
	bz if9_else

	// if9_elseif1_consequent
	// src/OrangeMiner.algo.ts:300
	// this.prices.value = castBytes<StaticArray<uint128, 10>>(
	//           extract3(rawBytes(this.prices.value), 16, 144) + rawBytes(price),
	//         )
	byte 0x70 // "p"
	dup
	int 16
	int 144
	box_extract
	frame_dig 4 // price: unsafe uint128
	dup
	bitlen
	int 128
	<=
	assert
	byte 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
	b&
	dup
	len
	dup
	int 16
	-
	swap
	substring3
	concat
	box_put
	b if9_end

if9_else:
	// src/OrangeMiner.algo.ts:305
	// i = 1
	int 1
	frame_bury 5 // i: uint64

for_0:
	// src/OrangeMiner.algo.ts:305
	// i < 10
	frame_dig 5 // i: uint64
	int 10
	<
	bz for_0_end

	// if10_condition
	// src/OrangeMiner.algo.ts:306
	// price <= this.prices.value[i]
	frame_dig 4 // price: unsafe uint128
	frame_dig 5 // i: uint64
	int 16
	* // acc * typeLength
	int 16
	byte 0x70 // "p"
	cover 2
	box_extract
	b<=
	bz if10_end

	// if10_consequent
	// src/OrangeMiner.algo.ts:307
	// index = 16 * i
	int 16
	frame_dig 5 // i: uint64
	*
	frame_bury 6 // index: uint64

	// src/OrangeMiner.algo.ts:308
	// this.prices.value = castBytes<StaticArray<uint128, 10>>(
	//               extract3(rawBytes(this.prices.value), 16, index - 16) +
	//                 rawBytes(price) +
	//                 extract3(rawBytes(this.prices.value), index, 160 - index),
	//             )
	byte 0x70 // "p"
	dup
	box_get
	assert
	int 16
	frame_dig 6 // index: uint64
	int 16
	-
	extract3
	frame_dig 4 // price: unsafe uint128
	dup
	bitlen
	int 128
	<=
	assert
	byte 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
	b&
	dup
	len
