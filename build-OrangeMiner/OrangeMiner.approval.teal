	// src/OrangeMiner.algo.ts:224
	// receiver: to
	frame_dig -2 // to: Address
	itxn_field Receiver

	// src/OrangeMiner.algo.ts:225
	// amount: toSend - 1
	frame_dig 1 // toSend: uint64
	int 1
	-
	itxn_field Amount

	// src/OrangeMiner.algo.ts:226
	// fee: 0
	int 0
	itxn_field Fee

	// Submit inner transaction
	itxn_submit

if5_end:
	// src/OrangeMiner.algo.ts:230
	// this.totalDeposited.value = this.totalDeposited.value - toSend
	byte 0x746f74616c4465706f7369746564 // "totalDeposited"
	dup
	app_global_get
	frame_dig 1 // toSend: uint64
	-
	app_global_put

	// src/OrangeMiner.algo.ts:231
	// balance.deposited = balance.deposited - toSend
	int 0
	frame_dig -1 // from: Address
	int 0
	int 8
	box_extract
	btoi
	frame_dig 1 // toSend: uint64
	-
	itob
	frame_dig 0 // storage key//balance
	cover 2
	box_replace
	retsub

// withdraw(uint64,uint64)void
abi_route_withdraw:
	// depositBps: uint64
	txna ApplicationArgs 2
