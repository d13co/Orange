// mine()void
abi_route_mine:
	// execute mine()void
	callsub mine
	int 1
	return

// mine(): void
mine:
	proto 0 0

	// Push empty bytes after the frame pointer to reserve space for local variables
	byte 0x
	dupn 19

	// src/OrangeMiner.algo.ts:350
	// assert(this.totalDeposited.value > 0)
	byte 0x746f74616c4465706f7369746564 // "totalDeposited"
	app_global_get
	int 0
	>
	assert

	// src/OrangeMiner.algo.ts:353
	// block = globals.round - (globals.round % 5)
	global Round
	global Round
	int 5
	%
	-
	frame_bury 0 // block: uint64

	// src/OrangeMiner.algo.ts:354
	// isNewBlock =
	//       block !== (this.miningApplication.value.globalState('block') as uint64)
	frame_dig 0 // block: uint64
	byte 0x6d696e696e674170706c69636174696f6e // "miningApplication"
	app_global_get
	byte 0x626c6f636b // "block"
	app_global_get_ex
	assert
	!=
	frame_bury 1 // isNewBlock: bool

	// src/OrangeMiner.algo.ts:356
	// currentMiner = Address.fromBytes(
	//       this.miningApplication.value.globalState('current_miner') as bytes,
	//     )
	byte 0x6d696e696e674170706c69636174696f6e // "miningApplication"
	app_global_get
	byte 0x63757272656e745f6d696e6572 // "current_miner"
	app_global_get_ex
	assert
	frame_bury 2 // currentMiner: address

	// src/OrangeMiner.algo.ts:359
	// assert(isNewBlock || this.app.address !== currentMiner)
	frame_dig 1 // isNewBlock: bool
	dup
	bnz skip_or0
	global CurrentApplicationAddress
	frame_dig 2 // currentMiner: address
	!=
	||

skip_or0:
	assert

	// src/OrangeMiner.algo.ts:362
	// expandCost = globals.minTxnFee
	global MinTxnFee
	frame_bury 3 // expandCost: uint64

	// src/OrangeMiner.algo.ts:363
	// totalTransactions = 3
	int 3
	frame_bury 4 // totalTransactions: uint64

	// if11_condition
	// src/OrangeMiner.algo.ts:364
	// isNewBlock
	frame_dig 1 // isNewBlock: bool
	bz if11_end

	// if11_consequent
	// src/OrangeMiner.algo.ts:365
	// expandCost = expandCost + globals.minTxnFee
	frame_dig 3 // expandCost: uint64
	global MinTxnFee
	+
	frame_bury 3 // expandCost: uint64

	// src/OrangeMiner.algo.ts:366
	// totalTransactions = totalTransactions + 1
	frame_dig 4 // totalTransactions: uint64
	int 1
	+
	frame_bury 4 // totalTransactions: uint64

if11_end:
	// src/OrangeMiner.algo.ts:368
	// sendMethodCall<[Address], void>({
	//       applicationID: this.miningApplication.value,
	//       fee: expandCost,
	//       name: 'mine',
	//       methodArgs: [this.app.address],
	//     })
	itxn_begin
	int appl
	itxn_field TypeEnum
	method "mine(address)void"
	itxn_field ApplicationArgs

