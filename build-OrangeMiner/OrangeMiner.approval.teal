// withdraw(rewardsBps: number, depositBps: number): void
withdraw:
	proto 2 0

	// src/OrangeMiner.algo.ts:235
	// assert(rewardsBps <= 10000)
	frame_dig -1 // rewardsBps: number
	int 10000
	<=
	assert

	// src/OrangeMiner.algo.ts:236
	// assert(depositBps <= 10000)
